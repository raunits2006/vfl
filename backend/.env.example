# ============================================
# Valorant Fantasy League - Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env files to version control!

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://your_user:your_password@db:5432/valorant_fantasy_db

# ============================================
# REDIS
# ============================================
# Redis connection string for Celery
REDIS_URL=redis://redis:6379/0

# ============================================
# SECURITY (REQUIRED)
# ============================================
# JWT Secret Key - MUST be changed in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Optional: Separate admin secret key (if not set, derived from SECRET_KEY)
# ADMIN_SECRET_KEY=CHANGE_THIS_TO_A_DIFFERENT_SECURE_RANDOM_STRING

# JWT token expiration in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CORS (Production)
# ============================================
# Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://api.yourdomain.com
# Leave empty to use default localhost origins (development only)
ALLOWED_ORIGINS=

# ============================================
# ENVIRONMENT
# ============================================
# Set to "production" in production deployments
ENVIRONMENT=development

# ============================================
# SCORING
# ============================================
# Comma-separated list of match event patterns for fantasy scoring.
# Each entry is a SQL LIKE pattern. Default scores only VCT 2026: Americas Stage 1.
# Examples:
#   SCORING_MATCH_EVENTS=VCT 2026: Americas Stage 1
#   SCORING_MATCH_EVENTS=VCT 2026:%,VCT 2025:%
#   SCORING_MATCH_EVENTS=%
SCORING_MATCH_EVENTS=VCT 2026: Americas Stage 1

# ============================================
# EXTERNAL APIS
# ============================================
# VLR API endpoints (optional, uses defaults if not set)
# VLR_API_UPCOMING_MATCHES_URL=https://vlrggapi.vercel.app/match?q=upcoming
# VLR_API_LIVE_SCORE_URL=https://vlrggapi.vercel.app/match?q=live_score
