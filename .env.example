# ============================================
# Valorant Fantasy League - Root Environment Variables
# ============================================
# These variables are used by docker-compose.yml
# Copy this file to .env and fill in your values
# DO NOT commit .env files to version control!

# ============================================
# DATABASE (for docker-compose)
# ============================================
# These are used to configure the PostgreSQL container
POSTGRES_USER_ENV=valorant_fantasy_user
POSTGRES_PASSWORD_ENV=CHANGE_THIS_TO_A_SECURE_PASSWORD
POSTGRES_DB_ENV=valorant_fantasy_db

# This must match the above values
DATABASE_URL_ENV=postgresql://valorant_fantasy_user:CHANGE_THIS_TO_A_SECURE_PASSWORD@db:5432/valorant_fantasy_db
